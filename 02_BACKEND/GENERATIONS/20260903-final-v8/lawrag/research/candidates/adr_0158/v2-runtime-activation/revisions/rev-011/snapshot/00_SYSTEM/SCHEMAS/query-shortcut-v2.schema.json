{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:schema:query-shortcut-v2",
  "title": "Generation-locked reviewed query shortcut",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "shortcut_id", "status", "signature_sha256",
    "source_set_sha256", "authority_generation", "semantic_generation",
    "content_snapshot_sha256", "landings", "feedback_event_ids",
    "evidence_receipt_sha256", "revision", "previous_record_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "query-shortcut-v2"},
    "shortcut_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["CANDIDATE", "REVIEWED", "PINNED", "STALE", "REJECTED"]},
    "signature_sha256": {"$ref": "#/$defs/sha256"},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "authority_generation": {"$ref": "#/$defs/id"},
    "semantic_generation": {"$ref": "#/$defs/id"},
    "content_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "landings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": {"enum": ["STRUCTURAL_UNIT", "SEMANTIC_CLAUSE", "RULE", "PROVISO", "RELATION"]},
          "id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "feedback_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "evidence_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "revision": {"type": "integer", "minimum": 1},
    "previous_record_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
