{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:schema:rag-structure-artifact-v1",
  "title": "Self-contained immutable RAG structure document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "meta", "result"],
  "properties": {
    "schema_version": {"const": "rag-structure-artifact-v1"},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,191}$"},
    "meta": {"type": "object"},
    "result": {
      "type": "object",
      "required": ["nodes", "blocks"],
      "properties": {
        "nodes": {"type": "array", "items": {"type": "object"}},
        "blocks": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  }
}
