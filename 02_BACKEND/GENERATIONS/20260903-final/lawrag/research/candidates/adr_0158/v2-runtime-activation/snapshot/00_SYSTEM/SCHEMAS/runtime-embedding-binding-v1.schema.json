{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lawrag:schema:runtime-embedding-binding-v1",
  "title": "Release-proved embedding service binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "model_id", "model_revision", "model_artifact_sha256", "dimensions", "normalized", "document_profile", "query_profile", "endpoint", "serving_id", "tenant_id", "credential_binding_id", "credential_binding_version", "trust_policy_id", "trust_zone", "descriptor_sha256"],
  "properties": {
    "schema_version": {"const": "runtime-embedding-binding-v1"},
    "backend": {"enum": ["local", "genos"]},
    "model_id": {"$ref": "#/$defs/canonicalText"},
    "model_revision": {"$ref": "#/$defs/canonicalText"},
    "model_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "dimensions": {"type": "integer", "minimum": 1},
    "normalized": {"const": true},
    "document_profile": {"$ref": "#/$defs/canonicalText"},
    "query_profile": {"$ref": "#/$defs/canonicalText"},
    "endpoint": {"type": ["string", "null"]},
    "serving_id": {"type": ["string", "null"]},
    "tenant_id": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "credential_binding_id": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "credential_binding_version": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "trust_policy_id": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "trust_zone": {"enum": ["local", "internal", "external"]},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"backend": {"const": "local"}}},
      "then": {
        "properties": {
          "endpoint": {"type": "null"},
          "serving_id": {"type": "null"},
          "tenant_id": {"type": "null"},
          "credential_binding_id": {"type": "null"},
          "credential_binding_version": {"type": "null"},
          "trust_policy_id": {"type": "null"},
          "trust_zone": {"const": "local"}
        }
      },
      "else": {
        "properties": {
          "endpoint": {"type": "string", "minLength": 1},
          "serving_id": {"type": "string", "pattern": "^[0-9]+$"},
          "tenant_id": {"$ref": "#/$defs/canonicalText"},
          "credential_binding_id": {"$ref": "#/$defs/canonicalText"},
          "credential_binding_version": {"$ref": "#/$defs/canonicalText"},
          "trust_policy_id": {"$ref": "#/$defs/canonicalText"},
          "trust_zone": {"enum": ["internal", "external"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalText": {"type": "string", "pattern": "^(?=\\S)(?:[^\\u0000-\\u001f]*\\S)?$"}
  }
}
