{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-copy-plan-v1",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_manifest_sha256",
    "sequence",
    "items",
    "source_deletion_supported",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": "workspace-copy-plan-v1"},
    "workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sequence": {
      "const": ["copy-verify-0", "dual-read-compare", "final-verify"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "target", "fingerprint"],
        "properties": {
          "source": {"$ref": "#/$defs/relative_path"},
          "target": {"$ref": "#/$defs/relative_path"},
          "fingerprint": {"$ref": "#/$defs/fingerprint"}
        },
        "additionalProperties": false
      }
    },
    "source_deletion_supported": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\\\\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])(?!(?:.*/)?\\.{1,2}(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "fingerprint": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "bytes",
        "content_sha256",
        "merkle_sha256",
        "file_count",
        "directory_count"
      ],
      "properties": {
        "kind": {"enum": ["file", "directory"]},
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}(?![\\s\\S])"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "merkle_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 0},
        "directory_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "file"}}},
          "then": {
            "properties": {
              "file_count": {"const": 1},
              "directory_count": {"const": 0}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "directory"}}},
          "then": {
            "properties": {"directory_count": {"minimum": 1}}
          }
        }
      ]
    }
  }
}
