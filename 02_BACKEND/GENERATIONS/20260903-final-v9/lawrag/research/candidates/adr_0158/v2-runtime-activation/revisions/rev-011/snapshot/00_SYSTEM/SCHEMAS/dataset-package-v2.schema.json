{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset-package-v2",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "dataset_id",
    "version_id",
    "variant_id",
    "generation_id",
    "source_origin",
    "security_class",
    "representation",
    "authority",
    "export_policy",
    "build",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "dataset-package-v2"},
    "package_id": {"$ref": "#/$defs/identifier"},
    "dataset_id": {"$ref": "#/$defs/identifier"},
    "version_id": {"$ref": "#/$defs/identifier"},
    "variant_id": {"$ref": "#/$defs/identifier"},
    "generation_id": {"$ref": "#/$defs/identifier"},
    "source_origin": {
      "enum": [
        "public_external",
        "restricted_internal",
        "curated_shared",
        "synthetic"
      ]
    },
    "security_class": {"enum": ["public", "internal", "restricted"]},
    "representation": {"enum": ["real", "mock"]},
    "authority": {
      "enum": ["authoritative", "curated", "observation", "evaluation"]
    },
    "export_policy": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": [
        "build_id",
        "execution_site",
        "code_revision",
        "compiler_profile",
        "capabilities"
      ],
      "properties": {
        "build_id": {"$ref": "#/$defs/identifier"},
        "execution_site": {"enum": ["outside", "genos"]},
        "code_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])[\\s\\S]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF](?![\\s\\S])"
        },
        "compiler_profile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])[\\s\\S]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF](?![\\s\\S])"
        },
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["logical_id", "role", "path", "sha256"],
        "properties": {
          "logical_id": {"$ref": "#/$defs/identifier"},
          "role": {
            "enum": [
              "raw",
              "structure",
              "observation",
              "semantic",
              "relation",
              "lexical_index",
              "vector_index",
              "evaluation"
            ]
          },
          "path": {"$ref": "#/$defs/relative_path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "media_type": {"type": "string", "minLength": 1},
          "document_id": {"$ref": "#/$defs/identifier"}
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["security_class"],
        "properties": {"security_class": {"const": "restricted"}}
      },
      "then": {
        "properties": {
          "export_policy": {
            "properties": {"allowed": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["source_origin"],
        "properties": {"source_origin": {"const": "restricted_internal"}}
      },
      "then": {
        "properties": {
          "export_policy": {
            "properties": {"allowed": {"const": false}}
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{1,127}(?![\\s\\S])"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])(?!.*[\\\\\\u0000-\\u001F\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])(?!.*\\x20(?![\\s\\S]))(?!(?:.*/)?\\.{1,2}(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
