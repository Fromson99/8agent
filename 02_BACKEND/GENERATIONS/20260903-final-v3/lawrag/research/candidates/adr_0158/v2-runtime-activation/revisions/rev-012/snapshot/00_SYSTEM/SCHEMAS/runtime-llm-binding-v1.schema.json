{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lawrag:schema:runtime-llm-binding-v1",
  "title": "Release-proved product LLM binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "model_id", "model_revision", "model_artifact_sha256", "endpoint", "serving_id", "tenant_id", "credential_binding_id", "credential_binding_version", "trust_policy_id", "trust_zone", "temperature", "json_mode", "descriptor_sha256"],
  "properties": {
    "schema_version": {"const": "runtime-llm-binding-v1"},
    "backend": {"enum": ["disabled", "anthropic", "local", "genos", "openrouter"]},
    "model_id": {"const": "claude-haiku-4-5-20251001"},
    "model_revision": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "model_artifact_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "endpoint": {"type": ["string", "null"]},
    "serving_id": {"type": ["string", "null"]},
    "tenant_id": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "credential_binding_id": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "credential_binding_version": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "trust_policy_id": {"anyOf": [{"$ref": "#/$defs/canonicalText"}, {"type": "null"}]},
    "trust_zone": {"enum": ["none", "local", "internal", "external"]},
    "temperature": {"const": 0},
    "json_mode": {"const": "json_schema"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"backend": {"const": "disabled"}}},
      "then": {
        "properties": {
          "model_revision": {"type": "null"},
          "model_artifact_sha256": {"type": "null"},
          "endpoint": {"type": "null"},
          "serving_id": {"type": "null"},
          "tenant_id": {"type": "null"},
          "credential_binding_id": {"type": "null"},
          "credential_binding_version": {"type": "null"},
          "trust_policy_id": {"type": "null"},
          "trust_zone": {"const": "none"}
        }
      },
      "else": {
        "properties": {
          "model_revision": {"$ref": "#/$defs/canonicalText"},
          "model_artifact_sha256": {"$ref": "#/$defs/sha256"},
          "endpoint": {"type": "string", "minLength": 1},
          "credential_binding_id": {"$ref": "#/$defs/canonicalText"},
          "credential_binding_version": {"$ref": "#/$defs/canonicalText"},
          "trust_policy_id": {"$ref": "#/$defs/canonicalText"},
          "trust_zone": {"enum": ["local", "internal", "external"]}
        }
      }
    },
    {
      "if": {"properties": {"backend": {"const": "genos"}}},
      "then": {
        "properties": {
          "serving_id": {"type": "string", "pattern": "^[0-9]+$"},
          "tenant_id": {"$ref": "#/$defs/canonicalText"},
          "trust_zone": {"enum": ["internal", "external"]}
        }
      },
      "else": {
        "properties": {
          "serving_id": {"type": "null"},
          "tenant_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"backend": {"enum": ["anthropic", "openrouter"]}}},
      "then": {"properties": {"trust_zone": {"const": "external"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalText": {"type": "string", "pattern": "^(?=\\S)(?:[^\\u0000-\\u001f]*\\S)?$"}
  }
}
