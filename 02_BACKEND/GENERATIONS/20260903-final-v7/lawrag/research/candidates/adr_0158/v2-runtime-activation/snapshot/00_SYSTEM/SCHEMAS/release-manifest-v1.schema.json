{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-manifest-v1",
  "type": "object",
  "required": [
    "schema_version", "release_id", "target", "layout_version", "created_at",
    "code", "main", "source_set", "semantics", "indexes"
  ],
  "properties": {
    "schema_version": {"const": "release-manifest-v1"},
    "release_id": {"type": "string", "minLength": 2},
    "target": {"enum": ["genos", "onsite", "local"]},
    "layout_version": {"enum": ["v1", "v2"]},
    "created_at": {"type": "string", "minLength": 1},
    "code": {
      "type": "object",
      "required": ["revision", "package_sha256"],
      "properties": {
        "revision": {
          "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "package_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "main": {
      "type": "object",
      "required": [
        "pipeline_id", "runtime_profile", "generation", "state_sha256",
        "promotion_receipt_sha256", "promotion_plan_sha256"
      ],
      "properties": {
        "pipeline_id": {"type": "string", "minLength": 2},
        "runtime_profile": {"type": "string", "minLength": 2},
        "generation": {"type": "integer", "minimum": 0},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "promotion_receipt_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "promotion_plan_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"generation": {"const": 0}},
            "required": ["generation"]
          },
          "then": {
            "properties": {
              "promotion_receipt_sha256": {"type": "null"},
              "promotion_plan_sha256": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "promotion_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "promotion_plan_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "source_set": {
      "type": "object",
      "required": ["id", "generation_id", "sha256", "export_allowed"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "generation_id": {"type": "string", "minLength": 2},
        "sha256": {"$ref": "#/$defs/sha256"},
        "export_allowed": {"type": "boolean"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "lock_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_artifact_sha256": {"$ref": "#/$defs/sha256"}
      },
      "dependentRequired": {
        "lock_sha256": ["lock_artifact_sha256", "materialization_sha256", "materialization_receipt_sha256", "catalog_sha256", "catalog_artifact_sha256"],
        "lock_artifact_sha256": ["lock_sha256", "materialization_sha256", "materialization_receipt_sha256", "catalog_sha256", "catalog_artifact_sha256"],
        "materialization_sha256": ["lock_sha256", "lock_artifact_sha256", "materialization_receipt_sha256", "catalog_sha256", "catalog_artifact_sha256"],
        "materialization_receipt_sha256": ["lock_sha256", "lock_artifact_sha256", "materialization_sha256", "catalog_sha256", "catalog_artifact_sha256"],
        "catalog_sha256": ["lock_sha256", "lock_artifact_sha256", "materialization_sha256", "materialization_receipt_sha256", "catalog_artifact_sha256"],
        "catalog_artifact_sha256": ["lock_sha256", "lock_artifact_sha256", "materialization_sha256", "materialization_receipt_sha256", "catalog_sha256"]
      },
      "additionalProperties": false
    },
    "semantics": {
      "type": "object",
      "required": [
        "generation_id", "authority_generation", "content_sha256",
        "source_set_sha256", "runtime_wired"
      ],
      "properties": {
        "generation_id": {"type": "string", "minLength": 2},
        "authority_generation": {"type": "string", "minLength": 2},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_set_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_wired": {"const": true}
      },
      "additionalProperties": false
    },
    "indexes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind", "artifact_id", "artifact_sha256", "source_set_sha256",
          "semantic_generation", "build_fingerprint"
        ],
        "properties": {
          "kind": {"enum": ["lexical", "vector"]},
          "artifact_id": {"type": "string", "minLength": 2},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "source_set_sha256": {"$ref": "#/$defs/sha256"},
          "semantic_generation": {"type": "string", "minLength": 2},
          "build_fingerprint": {"$ref": "#/$defs/sha256"},
          "embedding_model_fingerprint": {
            "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "vector"}}},
            "then": {
              "required": ["embedding_model_fingerprint"],
              "properties": {
                "embedding_model_fingerprint": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        ]
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
