{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:schema:rag-lexical-index-identity-v1",
  "title": "Release-bound lexical index build identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "source_set_id",
    "source_set_generation",
    "source_set_sha256",
    "semantic_generation",
    "authority_generation",
    "build_fingerprint",
    "document_ids",
    "structure_artifacts",
    "entry_count",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rag-lexical-index-identity-v1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "source_set_id": {"$ref": "#/$defs/id"},
    "source_set_generation": {"$ref": "#/$defs/id"},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_generation": {"$ref": "#/$defs/id"},
    "authority_generation": {"$ref": "#/$defs/id"},
    "build_fingerprint": {"$ref": "#/$defs/sha256"},
    "document_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "structure_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "qualified_id", "sha256"],
        "properties": {
          "document_id": {"$ref": "#/$defs/id"},
          "qualified_id": {"$ref": "#/$defs/id"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "entry_count": {"type": "integer", "minimum": 0},
    "identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,191}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
