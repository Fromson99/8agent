{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-legacy-retirement-authorization-v1",
  "x-source-evidence-schema-id": "workspace-legacy-retirement-source-v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "retirement_id",
    "workspace_manifest_sha256",
    "activation_receipt_path",
    "activation_receipt_sha256",
    "activation_id",
    "validation_receipt_path",
    "validation_receipt_sha256",
    "validation_record_sha256",
    "plan_sha256",
    "sources",
    "source_deletion_performed",
    "source_absence_authorized",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "workspace-legacy-retirement-authorization-v1"
    },
    "status": {"const": "authorized"},
    "retirement_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])[\\s\\S]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF](?![\\s\\S])"
    },
    "workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "activation_receipt_path": {"$ref": "#/$defs/relative_path"},
    "activation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "activation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])[\\s\\S]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF](?![\\s\\S])"
    },
    "validation_receipt_path": {"$ref": "#/$defs/relative_path"},
    "validation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "validation_record_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/retirement_source_evidence"},
      "uniqueItems": true
    },
    "source_deletion_performed": {"const": false},
    "source_absence_authorized": {"const": true},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\\\\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])(?!(?:.*/)?\\.{1,2}(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "fingerprint": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "bytes",
        "content_sha256",
        "merkle_sha256",
        "file_count",
        "directory_count"
      ],
      "properties": {
        "kind": {"enum": ["file", "directory"]},
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}(?![\\s\\S])"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "merkle_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 0},
        "directory_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "file"}}},
          "then": {
            "properties": {
              "file_count": {"const": 1},
              "directory_count": {"const": 0}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "directory"}}},
          "then": {
            "properties": {"directory_count": {"minimum": 1}}
          }
        }
      ]
    },
    "retirement_source_evidence": {
      "type": "object",
      "required": [
        "source",
        "target",
        "fingerprint",
        "final_item_sha256",
        "provenance_sha256"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/relative_path"},
        "target": {"$ref": "#/$defs/relative_path"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "final_item_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
