# API 설정 템플릿 — 필요한 것만 채우면 된다. 전부 선택값이다.
#   cp api/.env.example .env      (docker compose 가 자동으로 읽는다)

# --- LLM ---------------------------------------------------------------------
# first-agent 는 이 키가 없으면 스냅샷 재생 모드로만 돈다.
# trust-parser 는 키 없이 전부 동작한다 (--llm-* 선택 단계만 제외).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- 서버 ---------------------------------------------------------------------
PORT=5555              # GenOS 예제와 같은 포트

# --- 접근 제어 -----------------------------------------------------------------
# 설정하면 모든 /v1/* 요청에 `Authorization: Bearer <값>` 이 필요하다. 공개 배포면 반드시 설정.
API_TOKEN=
CORS_ORIGINS=*

# --- 한도 ---------------------------------------------------------------------
MAX_UPLOAD_MB=40
MAX_WAIT_SECONDS=240
JOB_TTL_SECONDS=21600

# --- 동시성 -------------------------------------------------------------------
PARSER_WORKERS=2
AGENT_WORKERS=1        # 스냅샷·용어집 파일을 공유하므로 1 을 권장

# --- 경로 (기본값이면 건드릴 필요 없음) --------------------------------------------
# TRUST_PARSER_ROOT=/app/trust-parser
# FIRST_AGENT_ROOT=/app/first-agent
# ONTOLOGY_PATH=/app/trust-parser/ontology/trust_contract.ontology.yaml
# SNAPSHOT_PATH=/app/first-agent/snapshots/run.json
# WORK_DIR=/tmp/trust-api
# SERVE_VIEWER=1
