# 로컬 개발용 예시입니다. 이 파일에는 실제 키를 넣지 마세요.
# GenOS에서는 코드 서빙 상세 > 환경 설정에 같은 이름을 등록하고 키 값은 잠급니다.

# GenOS 코드 서빙 호출 클라이언트(scripts/genos_call.sh)
GENOS_CODE_URL=
GENOS_CODE_KEY=

# 답변 합성용 GenOS LLM 서빙
LLM_BACKEND=
GENOS_LLM_URL=
GENOS_LLM_KEY=
GENOS_LLM_MODEL=
GENOS_LLM_JSON_MODE=json_schema
# 법률 조사 selector: reduced(기본, Qwen/vLLM 호환) | native
GENOS_LLM_SCHEMA_PROFILE=reduced
GENOS_LLM_TEMPERATURE=0
GENOS_USER_ID=

# OpenRouter(Qwen3.8) — LLM_BACKEND=openrouter 일 때 사용합니다.
# 키는 OPEN_ROUTER 또는 표준 이름 OPENROUTER_API_KEY 중 하나만 설정합니다.
OPEN_ROUTER=
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_JSON_MODE=json_schema
OPENROUTER_SCHEMA_PROFILE=native
OPENROUTER_TEMPERATURE=0
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=8-AGENT

# 색인 생성과 질의에 반드시 같은 임베딩 서빙·모델을 사용합니다.
EMBED_BACKEND=
GENOS_EMBED_URL=
GENOS_EMBED_KEY=
GENOS_EMBED_MODEL=
GENOS_EMBED_BATCH=64

# GenOS 영속/공유 볼륨의 실제 마운트 경로로 설정합니다.
# 비워 두면 저장소 아래 data/가 기본이지만 재배포 시 유실될 수 있습니다.
STRUCTURE_STORE=
STRUCTURE_CUSTOM_DIR=
GLOSSARY_STORE=
RAG_LINKS_STORE=
# 사람이 승인한 proof-carrying Assertion shortcut JSON. 없으면 B1 트리로 fallback.
RAG_ASSERTION_SHORTCUT_STORE=
OPS_DIR=

# 선택 운영 설정
MAX_UPLOAD_MB=40
STRUCTURE_RENDER_SCALE=2.0
OPS_RECORD=0
OPS_ALLOW_RESTORE=0
OPS_INBOX_DIR=
OPS_INBOX_POLL=10
