# 로컬 OpenAI-compatible LLM (llama.cpp server, vLLM, Ollama /v1 등)
LLM_BACKEND=local
LOCAL_LLM_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=claude-haiku-4-5-20251001
LOCAL_LLM_KEY=
LOCAL_LLM_JSON_MODE=json_schema
LOCAL_LLM_TEMPERATURE=0

# 로컬 임베딩. 모델 디렉터리를 절대경로로 지정하면 인터넷이 필요 없다.
EMBED_BACKEND=local
EMBED_MODEL=/opt/lawrag/models/bge-m3
EMBED_DEVICE=cpu
EMBED_CPU_THREADS=4
EMBED_LOCAL_FILES_ONLY=1

# file(기본) 또는 qdrant
RAG_VECTOR_BACKEND=qdrant
RAG_VECTOR_STORE=/opt/lawrag/data/embeddings/sections
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=lawrag_sections
QDRANT_API_KEY=

# 데이터/상태를 모두 반입 볼륨 아래에 고정
STRUCTURE_STORE=/opt/lawrag/data/structure
PIPELINE_DIR=/opt/lawrag/data/pipeline
PIPELINE_INBOX=/opt/lawrag/data/inbox
CORPUS_DIR=/opt/lawrag/data/corpus

# 폐쇄망 강제
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ONSITE_ALLOWED_HOSTS=
