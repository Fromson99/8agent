# GENOS 운영 RAG 코드서빙 — 분리 워크플로우 + 멀티턴 기준.
# 자동으로 읽는 파일이 아닙니다. 코드서빙 리비전의 환경 설정에 등록합니다.
# 빈 값은 현장 값을 채우고, *_KEY는 비밀 값으로 잠급니다.
# 시작: python3 main_router.py. 기존 리비전의 수신 포트 설정을 유지합니다.

# 실행 방식: 통합 직접 JSON은 integrated로 변경합니다.
GENOS_MAIN_MODE=workflow
# RAG 구현은 배포된 MAIN 코드의 PIPELINE.json 기본값을 따릅니다.
# 현재 기본값은 legal-agent-unified-v6이며 별도 구현 override는 필요 없습니다.

# SQLite 모드에서만 사용하는 검증 generation 디렉터리. Oracle 모드는 조회 릴리스를 선택합니다.
GENOS_GENERATION=
# 기존 NFS runtime을 재사용합니다. 경로 변경은 기존 상태를 자동 이관하지 않습니다.
GENOS_RUNTIME_DIR=/nfs-root/diamo/8-agent/runtime
GENOS_SHARED_LOG_DIR=/nfs-root/diamo/8-agent/rag-request-reports

# 내부 답변 모델: 기존 GENOS 주소·LLM 서빙 ID·인증키를 사용합니다.
SEMANTIC_LLM_BACKEND=genos
GENOS_BASE_URL=
GENOS_LLM_SERVING_ID=
GENOS_LLM_KEY=
# RAG/AD 출력 길이는 모델 서버가 결정합니다. 요청에 max_tokens를 보내지 않습니다.
# GENOS_RAG_MAX_OUTPUT_TOKENS는 폐기되어 기존 값이 남아 있어도 무시합니다.
# 모델 서버 자체의 컨텍스트/출력 제한과 아래 시간/총 호출 예산은 유지됩니다.
# 질문당 조사 한도. 코드서빙 환경에 등록하고 재시작하면 새 요청부터 적용됩니다.
# 로컬 service.service도 같은 설정을 사용합니다. 비어 있으면 선택 프로필 값을 유지합니다.
# 모델 호출 총량은 수정·재시도·최종 판단을 포함합니다. v6는 3회를 최종 판단에 예약합니다.
GENOS_RAG_MAX_MODEL_ATTEMPTS=40
GENOS_RAG_MAX_TOOL_ACTIONS=1024
GENOS_RAG_WALL_SECONDS=1800
# 법령 추가 검색 횟수와 최종 판단 후 부족 근거 재조사 횟수. 재조사는 0으로 끌 수 있습니다.
GENOS_RAG_SEARCH_ROUNDS=8
GENOS_RAG_ASSESSMENT_REENTRY_LIMIT=2
# HEALTH 응답의 release.investigation_budget에서 실제 적용값을 확인합니다.
# /models가 단일 모델을 반환하면 모델 ID는 자동 조회합니다.
# 여러 모델을 반환하는 서빙만 GENOS_LLM_MODEL을 추가합니다.
# 직접 URL 방식이면 BASE_URL·SERVING_ID 대신 GENOS_LLM_URL을 사용합니다.

# 분리 워크플로우의 멀티턴 설정: workflow/workflow.env.example
# GENOS_MEMORY_SIGNING_KEY는 제거했습니다. 별도 서명키를 등록하지 않습니다.
# 기존 플랫폼·코드서빙 API 인증으로 접근하고 세션 식별자로 대화를 이어갑니다.
# 분리 방식의 TEAM_ID는 워크플로우에서 요청에 전달합니다.
# 통합 멀티턴은 아래 MEMORY_ENABLED와 TEAM_ID(또는 입력 team_id)를 사용합니다.
# GENOS_MEMORY_ENABLED=1
# TEAM_ID=risk_team
# 관리자 모드는 PIPELINE.json의 ad_management.enabled=false로 비활성화합니다.
# 일반 RAG에는 AD_WORKSPACE 설정이 필요하지 않습니다. 기존 관리 코드·기록은 보존합니다.
# 직접 채팅의 AD 진입은 기존 플랫폼 연결 확인 설정을 유지합니다:
# GENOS_CHAT_TRUST_PLATFORM_IDENTITY=1
# GENOS_CHAT_GATEWAY_TOKEN=<플랫폼이 Authorization: Bearer로 전달하는 값>
# 구축 전용 설정: 08_DEPLOYMENT/GENOS/pipeline.env.example
# 배포/빌드/서버 전체 원문 로그. RAG 요청별 공유 로그와 별도이며 NFS로 비동기 복사.
GENOS_SYSTEM_LOG_DIR=/nfs-root/diamo/8-agent/logs/system
GENOS_SYSTEM_LOG_LEVEL=INFO
# 상세 RAG 이벤트까지 원할 때 기존 GENOS_LOG_LEVEL=DEBUG를 사용한다.
# SQLite 모드는 NFS 불통 시 로컬 pending을 보존합니다.
# DP=oracle은 로컬 spool을 만들지 않으며 stdout과 외부 요청 로그를 사용합니다.
# GENOS_LOG_SPOOL_DIR=/tmp/8-agent-system-logs
# GENOS_CODESERVING_REVISION=<실제 배포 리비전; 자동 추정하지 않음>

# Oracle 직접 조회 (2026-10-19 작업 코드 + 조회 테이블 게시가 함께 필요)
# 기존 SQLite/NFS 모드는 DP=sqlite 또는 DP 미설정으로 유지합니다.
# DP=oracle
# 다음 두 설정 중 하나만 사용합니다. 기본값은 channel=main입니다.
# DP_QUERY_CHANNEL=main
# DP_QUERY_RELEASE_ID=<고정 조회 릴리스 ID; channel 설정을 지운 뒤 사용>
# DP_RELEASE_ID / DP_CACHE_DIR는 새 서빙 경로에서 사용하지 않습니다.
# 원문 릴리스 ID와 조회 릴리스 ID는 서로 다릅니다.
# ORACLE_ORDS_SCHEMA=b04
# ORACLE_ORDS_CLIENT_ID=
# ORACLE_ORDS_CLIENT_SECRET=
# ORACLE_ORDS_BASE_URL=
# GENOS_RUNTIME_DIR와 GENOS_SHARED_LOG_DIR는 실제 NFS/CIFS 마운트여야 합니다.
# 외부 상태 마운트가 없으면 실패하며 코드서빙 로컬 저장소로 대체하지 않습니다.
# 조회 테이블 DDL/게시/활성화: 06_TOOLS/pipeline.py oracle-query --help
