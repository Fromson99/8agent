# GenOS 코드 서빙 환경 설정 예시입니다.
# 이 파일에는 실제 인증키를 넣지 않습니다. GenOS 화면의 환경 설정에 각 값을 복사하고,
# *_KEY는 잠금/비밀 값으로 등록합니다. service.py는 이 파일을 자동으로 읽지 않습니다.

# GENOS_GENERATION은 선택값입니다. 비워 두면 GENOS_DATA_ROOT/generations/CURRENT.json이
# 가리키는 최신 발행본을 사용합니다. 특정 발행본 고정 시에만 절대경로를 넣습니다.
GENOS_GENERATION=
GENOS_RUNTIME_DIR=/home/genos/DEV/GENOS_DATA/runtime

# 제품 답변 LLM — URL과 KEY는 현장 서빙 값으로 채웁니다.
LLM_BACKEND=genos
GENOS_BASE_URL=
GENOS_LLM_PROFILE=qwen
GENOS_QWEN_SERVING_ID=
GENOS_QWEN_KEY=
GENOS_QWEN_MODEL=
# 현재 공식 경로는 /v1. 해당 현장 서빙이 /chat/completions를 바로 받으면 none.
GENOS_LLM_API_PREFIX=/v1
GENOS_LLM_JSON_MODE=json_schema
GENOS_LLM_SCHEMA_PROFILE=reduced
GENOS_LLM_TEMPERATURE=0

# 검색 임베딩 — 색인 생성과 질의에 같은 서빙/모델을 사용합니다.
EMBED_BACKEND=genos
GENOS_EMBED_SERVING_ID=
GENOS_EMBED_KEY=
GENOS_EMBED_MODEL=
GENOS_EMBED_API_PREFIX=/v1
GENOS_EMBED_BATCH=64

# GenOS Vector DB — 게이트웨이 URL이 아닌 Weaviate 직접 주소를 사용합니다.
# 콜렉션은 GenOS Vector DB 상세에서 확인한 문자열입니다.
GENOS_VDB_URL=http://llmops-weaviate-service:8080
GENOS_VDB_COLLECTION=
# 익명 내부 접속이면 비워 둡니다. Weaviate가 요구할 때만 설정합니다.
GENOS_VDB_TOKEN=

# 제품 RAG 답변은 승인된 내부 Haiku 호환 서빙만 사용합니다. 위 Qwen/Gemma
# authoring 접속정보를 제품 답변 경로로 자동 전환하지 않습니다.
SEMANTIC_LLM_ENDPOINT=
SEMANTIC_LLM_API_KEY=
SEMANTIC_LLM_API_PREFIX=/v1
SEMANTIC_LLM_TRUST_ZONE=internal

# GenOS 단일 코드스페이스 경로. 코드와 데이터 모두 /home/genos/DEV 아래에 두지만
# GENOS_DATA와 TRANSFER는 .gitignore로 차단해 원격 Git에는 코드만 올립니다.
# 외부 패키지 반입과 내부 업로드는 아래 서로 다른 입구에서 시작하지만, 모두
# GENOS_DATA_ROOT 아래 동일한 structure/corpus/pipeline 저장소로 합류합니다.
GENOS_DATA_ROOT=/home/genos/DEV/GENOS_DATA
# GenOS가 업로드 파일을 노출하는 읽기 가능 루트. 이 밖의 경로는 거부합니다.
GENOS_UPLOAD_ROOT=/nfs-root
STRUCTURE_STORE=/home/genos/DEV/GENOS_DATA/structure
STRUCTURE_CUSTOM_DIR=/home/genos/DEV/GENOS_DATA/custom
GLOSSARY_STORE=/home/genos/DEV/GENOS_DATA/glossary.json
RAG_LINKS_STORE=/home/genos/DEV/GENOS_DATA/links.json
RAG_LOG_DIR=/home/genos/DEV/GENOS_DATA/rag
RAG_RULES_DIR=/home/genos/DEV/GENOS_DATA/rules
RAG_VECTOR_STORE=/home/genos/DEV/GENOS_DATA/embeddings/sections
OPS_DIR=/home/genos/DEV/GENOS_DATA/ops
CORPUS_DIR=/home/genos/DEV/GENOS_DATA/corpus
WIKI_STORE=/home/genos/DEV/GENOS_DATA/wiki
EXPC_STORE=/home/genos/DEV/GENOS_DATA/expc
REVIEW_STORE=/home/genos/DEV/GENOS_DATA/review
AGENT6_CORPUS_DIR=/home/genos/DEV/GENOS_DATA/lawrag/agents/agent6/corpus

# 선택 운영값
MAX_UPLOAD_MB=40
STRUCTURE_RENDER_SCALE=2.0
# ADR0358: native PDF auto recipe + VLM correction (same path locally/GENOS).
# MAIN PDF ingestion: sampled source chunks -> format regions/templates -> bbox review.
# auto enables only with LLM_BACKEND=genos; off restores heuristic structure.
# This is a separate structural model budget, even when semantic use_llm=False.
STRUCTURE_RECIPE_VLM=auto
# full reviews every PDF page in bounded windows; adaptive samples layout/risk windows.
STRUCTURE_RECIPE_REVIEW_MODE=adaptive
STRUCTURE_RECIPE_MAX_CALLS=64
STRUCTURE_RECIPE_MAX_CORRECTIONS=6
STRUCTURE_RECIPE_MAX_PAGES=6
STRUCTURE_RECIPE_MAX_CHARS=160000
STRUCTURE_RECIPE_MAX_TOKENS=4096
# Optional persistent filename -> source-bound recipe JSON; default store parent.
# STRUCTURE_RECIPE_TAGS=/persistent/path/structure-recipes.json
OPS_RECORD=0
OPS_ALLOW_RESTORE=0
