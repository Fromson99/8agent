# GenOS 코드스페이스·코드서빙 환경 설정 예시입니다.
# 이 파일에는 실제 인증키를 넣지 않습니다. GenOS 화면의 환경 설정에 각 값을 복사하고,
# *_KEY는 잠금/비밀 값으로 등록합니다. service.py는 이 파일을 자동으로 읽지 않습니다.

# PDF 파싱: 코드스페이스 환경 설정에 등록. 모델 추론은 GENOS 전처리기에서 실행합니다.
# GENOS_PREPROCESSOR_ID=<선택한 파싱용 전처리기 ID> -> http://preprocessor-{ID}:8080/run
# ID를 코드에 고정하지 않습니다. URL을 넣으면 ID보다 우선하며 /run 또는 /parser까지 지정 가능합니다.
GENOS_PDF_PARSER=preprocessor
GENOS_PREPROCESSOR_ID=
GENOS_PREPROCESSOR_URL=
# auto: Docling 문서 또는 완전한 인덱스 청크 배열. docling/chunks로 엄격하게 선택 가능.
GENOS_PREPROCESSOR_RESPONSE_MODE=auto
# 전처리기의 코드/이미지/모델/설정 조합을 식별하는 배포 리비전. 변경 시 함께 갱신합니다.
# Optional cache version; when blank, structure reuse is scoped to run ID.
GENOS_PREPROCESSOR_REVISION=
# 양쪽에서 같은 파일을 읽을 수 있는 기존 공유 폴더. 아래는 예시이며 공유 그룹 읽기 권한 필요.
GENOS_PREPROCESSOR_SHARED_ROOT=/nfs-root/diamo/8-agent/parser-input
# 전처리기에서 동일 폴더가 다른 경로로 보일 때만 지정합니다. 공란이면 SHARED_ROOT와 동일.
GENOS_PREPROCESSOR_REMOTE_ROOT=
GENOS_PREPROCESSOR_TIMEOUT=900
GENOS_PREPROCESSOR_MAX_RESPONSE_MB=128
# 인증이 필요한 내부 주소에서만 사용. 요청 기록/캐시에는 남기지 않습니다.
GENOS_PREPROCESSOR_API_KEY=
# 구조 응답 서버: parser_processor + output.format=docling + enrichment 비활성화.
# 기존 청크 서버: 전체 결합 후 원본 PDF 전 페이지 VLM 틀 검수 필수.
# 상세: GENOS_PREPROCESSOR_PARSING.md

# GENOS_GENERATION은 선택값입니다. 비워 두면 GENOS_DATA_ROOT/generations/CURRENT.json이
# 가리키는 최신 발행본을 사용합니다. 특정 발행본 고정 시에만 절대경로를 넣습니다.
GENOS_GENERATION=
GENOS_RUNTIME_DIR=/home/genos/DEV/GENOS_DATA/runtime

# 제품 답변 LLM — URL과 KEY는 현장 서빙 값으로 채웁니다.
LLM_BACKEND=genos
GENOS_BASE_URL=
GENOS_LLM_PROFILE=qwen
GENOS_QWEN_SERVING_ID=
GENOS_QWEN_KEY=
GENOS_QWEN_MODEL=
# 현재 공식 경로는 /v1. 해당 현장 서빙이 /chat/completions를 바로 받으면 none.
GENOS_LLM_API_PREFIX=/v1
GENOS_LLM_JSON_MODE=json_schema
GENOS_LLM_SCHEMA_PROFILE=reduced
GENOS_LLM_TEMPERATURE=0

# 검색 임베딩 — 색인 생성과 질의에 같은 서빙/모델을 사용합니다.
EMBED_BACKEND=genos
GENOS_EMBED_SERVING_ID=
GENOS_EMBED_KEY=
GENOS_EMBED_MODEL=
GENOS_EMBED_API_PREFIX=/v1
GENOS_EMBED_BATCH=64

# GenOS Vector DB — 게이트웨이 URL이 아닌 Weaviate 직접 주소를 사용합니다.
# 콜렉션은 GenOS Vector DB 상세에서 확인한 문자열입니다.
GENOS_VDB_URL=http://llmops-weaviate-service:8080
GENOS_VDB_COLLECTION=
# 익명 내부 접속이면 비워 둡니다. Weaviate가 요구할 때만 설정합니다.
GENOS_VDB_TOKEN=

# 제품 RAG 답변은 승인된 내부 Haiku 호환 서빙만 사용합니다. 위 Qwen/Gemma
# authoring 접속정보를 제품 답변 경로로 자동 전환하지 않습니다.
SEMANTIC_LLM_ENDPOINT=
SEMANTIC_LLM_API_KEY=
SEMANTIC_LLM_API_PREFIX=/v1
SEMANTIC_LLM_TRUST_ZONE=internal

# GenOS 단일 코드스페이스 경로. 코드와 데이터 모두 /home/genos/DEV 아래에 두지만
# GENOS_DATA와 TRANSFER는 .gitignore로 차단해 원격 Git에는 코드만 올립니다.
# 외부 패키지 반입과 내부 업로드는 아래 서로 다른 입구에서 시작하지만, 모두
# GENOS_DATA_ROOT 아래 동일한 structure/corpus/pipeline 저장소로 합류합니다.
GENOS_DATA_ROOT=/home/genos/DEV/GENOS_DATA
# GenOS가 업로드 파일을 노출하는 읽기 가능 루트. 이 밖의 경로는 거부합니다.
GENOS_UPLOAD_ROOT=/nfs-root
STRUCTURE_STORE=/home/genos/DEV/GENOS_DATA/structure
STRUCTURE_CUSTOM_DIR=/home/genos/DEV/GENOS_DATA/custom
GLOSSARY_STORE=/home/genos/DEV/GENOS_DATA/glossary.json
RAG_LINKS_STORE=/home/genos/DEV/GENOS_DATA/links.json
RAG_LOG_DIR=/home/genos/DEV/GENOS_DATA/rag
RAG_RULES_DIR=/home/genos/DEV/GENOS_DATA/rules
RAG_VECTOR_STORE=/home/genos/DEV/GENOS_DATA/embeddings/sections
OPS_DIR=/home/genos/DEV/GENOS_DATA/ops
CORPUS_DIR=/home/genos/DEV/GENOS_DATA/corpus
WIKI_STORE=/home/genos/DEV/GENOS_DATA/wiki
EXPC_STORE=/home/genos/DEV/GENOS_DATA/expc
REVIEW_STORE=/home/genos/DEV/GENOS_DATA/review
AGENT6_CORPUS_DIR=/home/genos/DEV/GENOS_DATA/lawrag/agents/agent6/corpus

# 선택 운영값
MAX_UPLOAD_MB=40
STRUCTURE_RENDER_SCALE=2.0
# ADR0358: native PDF auto recipe + VLM correction (same path locally/GENOS).
# MAIN PDF ingestion: complete parsed text -> format templates -> PDF VLM review -> rebuild.
# auto enables only with LLM_BACKEND=genos; off restores heuristic structure.
# This is a separate structural model budget, even when semantic use_llm=False.
STRUCTURE_RECIPE_VLM=auto
# basic v37: authored article/paragraph template or disclosure partial-order profile.
# Compound articles + standalone writing guidance select disclosure_v1.json.
# Other numbering formats / explicit engine hints retain the existing initial engine.
# Recheck returns passage/reason to VLM (max2); unresolved review is saved with warnings.
# Text-only LLM selects scope/parents from corrections; code rebuilds and rechecks.
# Structure requests explicitly send enable_thinking=false; confirm server support onsite.
STRUCTURE_RECIPE_PROTOCOL=basic
STRUCTURE_RECIPE_ACCEPT_WARNINGS=on
# Applies to basic visual and correction requests; effective cap is min of both caps.
STRUCTURE_RECIPE_REVIEW_MAX_TOKENS=1024
STRUCTURE_RECIPE_REVIEW_MAX_CHARS=24000
# full reviews every PDF page in bounded windows; adaptive samples layout/risk windows.
STRUCTURE_RECIPE_REVIEW_MODE=adaptive
STRUCTURE_RECIPE_MAX_CALLS=64
STRUCTURE_RECIPE_MAX_CORRECTIONS=2
# One-page review of 404 pages needs at least 404 calls; the call cap is per document.
# Example long-document settings: MAX_PAGES=4 and MAX_CALLS=128 -> minimum 101 calls.
# Corrections/rechecks need additional calls. This example does not certify quality.
STRUCTURE_RECIPE_MAX_PAGES=1
STRUCTURE_RECIPE_MAX_CHARS=160000
STRUCTURE_RECIPE_MAX_TOKENS=4096
# Optional persistent filename -> source-bound recipe JSON; default store parent.
# STRUCTURE_RECIPE_TAGS=/persistent/path/structure-recipes.json
OPS_RECORD=0
OPS_ALLOW_RESTORE=0

# Optional team RAW PDF generation (separate from PDF parsing)
GENOS_PDF_CONVERSION=on
GENOS_PDF_CONVERTER_ID=187
# Existing NFS directory visible to both code-space and converter:
GENOS_PDF_CONVERTER_SHARED_ROOT=
GENOS_PDF_CONVERTER_REMOTE_ROOT=
GENOS_PDF_CONVERTER_REVISION=
GENOS_PDF_CONVERTER_TIMEOUT=900
# Optional override/auth: GENOS_PDF_CONVERTER_URL, GENOS_PDF_CONVERTER_API_KEY
# 문서 목록·폴더·목차·원문 도구와 복수 근거 종합 (명시 GENOS 세대 필요)
# GENOS_RAG_IMPLEMENTATION=document-navigation-v1
