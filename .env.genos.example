# GenOS 코드 서빙 환경 설정 예시입니다.
# 이 파일에는 실제 인증키를 넣지 않습니다. GenOS 화면의 환경 설정에 각 값을 복사하고,
# *_KEY는 잠금/비밀 값으로 등록합니다. service.py는 이 파일을 자동으로 읽지 않습니다.

# 제품 답변 LLM — URL과 KEY는 현장 서빙 값으로 채웁니다.
LLM_BACKEND=genos
GENOS_LLM_URL=
GENOS_LLM_KEY=
GENOS_LLM_MODEL=claude-haiku-4-5-20251001
GENOS_LLM_JSON_MODE=json_schema
GENOS_LLM_SCHEMA_PROFILE=reduced
GENOS_LLM_TEMPERATURE=0

# 검색 임베딩 — 색인 생성과 질의에 같은 서빙/모델을 사용합니다.
EMBED_BACKEND=genos
GENOS_EMBED_URL=
GENOS_EMBED_KEY=
GENOS_EMBED_MODEL=
GENOS_EMBED_BATCH=64

# GenOS 영속 공유 볼륨
STRUCTURE_STORE=/mnt/8-agent/data/structure
STRUCTURE_CUSTOM_DIR=/mnt/8-agent/data/custom
GLOSSARY_STORE=/mnt/8-agent/data/glossary.json
RAG_LINKS_STORE=/mnt/8-agent/data/links.json
RAG_LOG_DIR=/mnt/8-agent/data/rag
RAG_RULES_DIR=/mnt/8-agent/data/rules
RAG_VECTOR_STORE=/mnt/8-agent/data/embeddings/sections
OPS_DIR=/mnt/8-agent/data/ops
CORPUS_DIR=/mnt/8-agent/data/corpus
WIKI_STORE=/mnt/8-agent/data/wiki
EXPC_STORE=/mnt/8-agent/data/expc
REVIEW_STORE=/mnt/8-agent/data/review
AGENT6_CORPUS_DIR=/mnt/8-agent/lawrag/agents/agent6/corpus

# 선택 운영값
MAX_UPLOAD_MB=40
STRUCTURE_RENDER_SCALE=2.0
OPS_RECORD=0
OPS_ALLOW_RESTORE=0
