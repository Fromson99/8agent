  "child_decisions": {
    "3": {
      "target_id": "Tc378c42da88c72308d4fe83b299d",
      "query": null,
      "reason": "질문의 핵심인 부동산 PF 사업성 평가 악화 시 자산건전성 분류·대손충당금 적립 기준의 직접 원문(제6-15조)을 확보해야 하며, 현재는 미리보기만 존재한다."
    },
    "4": {
      "target_id": null,
      "query": null,
      "reason": "제6-15조 원문 확보 완료. 별표 17-1·17-2는 미해결 연결로 부모에게 전달되며, 추가 조사는 부모 판단에 맡김."
    },
    "7": {
      "target_id": "T8a98ddb34f74f7b75646fbdc11cf",
      "query": null,
      "reason": "질문은 사업성 평가 악화 시 건전성 분류·대손충당금 적립 기준을 요구하며, 확보된 제6-15조는 세부기준을 별표 17-1에 위임한다. 별표 17-1 중 '다. 건전성 분류 및 사후관리'는 평가 등급별 건전성 분류(정상·요주의·고정이하 등)와 대손충당금 관련 사후관리 기준을 직접 담고 있어, 현재 확보된 '가. 사업성 평가원칙'만으로는 부족하다. 해당 원문을 읽어야 질문의 남은 내용(분류·적립 기준)을 부모에게 전달할 수 있다."
    },
    "8": {
      "target_id": null,
      "query": null,
      "reason": "질문(외부 기준: 사업성 평가 악화 시 자산건전성 분류·대손충당금 적립)에 직접 필요한 원문인 제6-15조, 별표 17-1 '가. 사업성 평가원칙', '다. 건전성 분류 및 사후관리'는 이미 확보·제시되어 있고, 남은 미확인 연결(별표 17-2, 금융투자업규정 제3-7조 등)은 부모의 비교·충분성 판단에 맡길 수 있어 추가 조사 대상이 없다."
    }
  },
