{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:legal-agent-state-proposal-v1",
  "$comment": "Design-only schema; not installed in PIPELINE. Cross-reference, hash, temporal and transition checks need server code.",
  "$ref": "#/$defs/State",
  "$defs": {
    "Binding": {
      "type": "object",
      "properties": {
        "controller_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "domain_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_store_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "navigation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fulltext_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_overlay_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "auth_scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "controller_sha256",
        "domain_id",
        "domain_sha256",
        "profile_id",
        "profile_sha256",
        "generation_id",
        "source_store_sha256",
        "navigation_sha256",
        "fulltext_sha256",
        "reference_overlay_sha256",
        "auth_scope_sha256",
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "EvidenceSpan": {
      "type": "object",
      "properties": {
        "span_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_store_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "normative",
            "interpretive",
            "reference"
          ]
        },
        "temporal_status": {
          "enum": [
            "verified",
            "unknown"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "span_id",
        "source_id",
        "generation_id",
        "source_store_sha256",
        "document_id",
        "source_artifact_sha256",
        "unit_id",
        "block_id",
        "start",
        "end",
        "text_sha256",
        "role",
        "temporal_status",
        "valid_from",
        "valid_to"
      ],
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^E[1-9][0-9]*$"
        },
        "span_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "presented_call_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "handle",
        "span_ids",
        "presented_call_ids"
      ],
      "additionalProperties": false
    },
    "SearchAttempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "fts",
            "locator",
            "reference",
            "reverse_reference",
            "definition",
            "outline"
          ]
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "EMPTY",
            "ERROR",
            "BLOCKED"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "issue_id",
        "method",
        "query_sha256",
        "scope_sha256",
        "result_sha256",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "question_segment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "question",
            "domain_rule",
            "source_signal"
          ]
        },
        "evidence_state": {
          "enum": [
            "OPEN",
            "EVIDENCE_LINKED",
            "SEARCHED_UNRESOLVED",
            "CONFLICTED",
            "NOT_APPLICABLE"
          ]
        },
        "fact_state": {
          "enum": [
            "not_needed",
            "stated",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "search_attempt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "kind",
        "question_segment_ids",
        "required",
        "origin",
        "evidence_state",
        "fact_state",
        "evidence_refs",
        "search_attempt_ids",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "EVIDENCE_LINKED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "reason": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "SEARCHED_UNRESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "search_attempt_ids": {
                "minItems": 1
              },
              "reason": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "CONFLICTED",
                  "NOT_APPLICABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Budget": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "used_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_composition_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_nav_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "max_attempts",
        "used_attempts",
        "reserved_composition_attempts",
        "max_nav_rounds",
        "max_input_tokens",
        "max_output_tokens",
        "deadline_utc"
      ],
      "additionalProperties": false
    },
    "State": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "legal-agent-state-proposal-v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "status": {
          "enum": [
            "BOUND",
            "EXPLORING",
            "READY",
            "BOUNDED",
            "CLARIFY",
            "COMPOSING",
            "VERIFYING",
            "FINAL",
            "FAILED"
          ]
        },
        "response_class": {
          "enum": [
            "unresolved",
            "complete",
            "partial",
            "clarify",
            "failed"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "searches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchAttempt"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "selected_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "binding",
        "status",
        "response_class",
        "issues",
        "spans",
        "evidence",
        "searches",
        "selected_source_ids",
        "budget"
      ],
      "additionalProperties": false
    }
  }
}
