{
  "schema_version": "dataset-sync-profiles-v1",
  "common-runtime": {
    "classification": "shared-identical",
    "include": [
      "data/corpus/expc",
      "data/corpus/forms",
      "data/corpus/fsc",
      "data/corpus/kofia",
      "data/corpus/krx",
      "data/corpus/law",
      "data/corpus/law_history",
      "data/corpus/moleg",
      "data/corpus/prec",
      "data/structure",
      "data/frames",
      "data/taxonomy",
      "data/wiki",
      "data/expc",
      "data/aliases.json",
      "data/glossary.json",
      "data/delegation.json",
      "data/law_index.json",
      "data/links.json"
    ],
    "exclude_globs": [
      "data/structure/*/pages/**",
      "data/structure/*/source.pdf",
      "data/structure/*/parse.json",
      "**/*.bak",
      "**/*.npz"
    ]
  },
  "common-evaluation": {
    "classification": "shared-identical-evaluation",
    "include": [
      "data/bench",
      "data/review",
      "docs/examples/README.md",
      "docs/examples/task3-law-chatbot/qa.yaml",
      "docs/examples/task5-risk-agent/qa"
    ],
    "exclude_globs": ["**/*.bak"]
  },
  "external_overlay": "config/dataset_sync/external-mock-overlay.json",
  "internal_overlay_template": "config/dataset_sync/internal-real-overlay.example.json"
}
