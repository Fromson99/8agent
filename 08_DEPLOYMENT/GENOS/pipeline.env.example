# GENOS 코드스페이스 구축용. 빈 값은 현장 서빙 설정으로 채운다.
# 실제 키를 Git이나 반입 ZIP에 넣지 않는다.
LLM_BACKEND=genos
EMBED_BACKEND=genos
SEMANTIC_LLM_BACKEND=genos
GENOS_BASE_URL=
GENOS_LLM_SERVING_ID=
GENOS_LLM_KEY=
# 단일 모델은 /models에서 자동 조회. 모델이 여러 개일 때만 명시합니다.
GENOS_LLM_MODEL=
GENOS_EMBED_SERVING_ID=
GENOS_EMBED_KEY=
GENOS_EMBED_MODEL=
# 구축 게이트웨이 경로. 현장에서 /v1이 필요한 경우에만 변경.
GENOS_GATEWAY_API_PREFIX=none
# 직접 URL 방식인 경우 위 게이트웨이 대신 사용.
# GENOS_LLM_URL=
# GENOS_LLM_API_PREFIX=/v1
# GENOS_EMBED_URL=
# GENOS_EMBED_API_PREFIX=/v1
STRUCTURE_RECIPE_VLM=auto
STRUCTURE_RECIPE_REVIEW_MODE=adaptive
STRUCTURE_RECIPE_MAX_CALLS=64
STRUCTURE_RECIPE_MAX_CORRECTIONS=6
STRUCTURE_RECIPE_MAX_PAGES=6
STRUCTURE_RECIPE_MAX_CHARS=160000
STRUCTURE_RECIPE_MAX_TOKENS=4096
# 색인 구축 프로세스 전용. 0=기존 연결관계(v4), 1=구조 앵커·문장 범위 연결(v5).
# 기존 구조화 세대 E2E를 마친 뒤 새 run ID의 색인 빌드에서만 1을 명시한다.
# 코드서빙 환경변수가 아니며 이미 완성된 세대의 연결관계를 바꾸지 않는다.
GENOS_REFERENCE_SCOPE_V2=0
# 서비스 배포 단계에서만 검증된 통합 세대를 지정한다.
# GENOS_GENERATION=/현장/검증된/통합세대
