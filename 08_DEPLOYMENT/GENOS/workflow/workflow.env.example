# GENOS workflow revision settings (separate from code-serving environment).
GENOS_BASE_URL=http://<GENOS주소>
GENOS_CODESERVING_ID=<코드서빙ID>
GENOS_CODESERVING_TOKEN=<코드서빙 API 인증키>
GENOS_CODESERVING_TIMEOUT_SECONDS=2100
# Enable only after the V1.8.6 chat probe confirms live rendering.
# Socket rendering is separate from transport: off still reads /stream.
# Missing /stream (HTTP 404/405) falls back to /json once.
GENOS_RAG_PROGRESS_UI=socketio
# Overrides incoming team_id. Remove TEAM_ID entirely to use the input selector.
# Separate workflows: risk workflow uses risk_team; finance workflow uses financial_team.
# The same team_id also groups shared reports into YYYY-MM-DD/<team_id>/.
TEAM_ID=risk_team
