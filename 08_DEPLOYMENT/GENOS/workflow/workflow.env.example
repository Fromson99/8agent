# GENOS 분리 Python 워크플로우 — 코드서빙과 별도 리비전 환경에 등록합니다.
# 빈 값은 현장 값을 채우고 TOKEN은 비밀 값으로 잠급니다.
GENOS_BASE_URL=
# 답변 LLM ID가 아니라 /stream RAG 코드서빙 ID입니다.
GENOS_CODESERVING_ID=
GENOS_CODESERVING_TOKEN=

# 세션 멀티턴: 플랫폼의 실제 사용자·대화 식별자를 전달합니다.
# user_wiki와 별도 signing은 사용하지 않습니다.
GENOS_MEMORY_ENABLED=1
# 입력 team_id보다 우선하는 문서 선택 범위입니다.
# 재무팀 워크플로우는 financial_team으로 변경합니다.
TEAM_ID=risk_team
# 단일 질문만 운영하면 MEMORY_ENABLED를 제거합니다.
# 대기시간은 기본 2100초. 워크플로우는 Socket.IO를 사용하지 않습니다.
# 별도 Python 단계도 동일 NFS를 mount하고 새 WORKFLOW_PASTE_ALL TXT를 반영한다.
GENOS_SYSTEM_LOG_DIR=/nfs-root/diamo/8-agent/logs/system
