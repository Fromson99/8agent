{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:legal-knowledge:source-binding-v1",
  "type": "object",
  "properties": {
    "generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "store_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_index_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "generation",
    "store_sha256",
    "unit_index_sha256"
  ],
  "additionalProperties": false
}
