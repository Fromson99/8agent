{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:legal-knowledge:command-v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "legal-knowledge-v1"
    },
    "operation": {
      "enum": [
        "save_draft",
        "prepare_publication",
        "publish",
        "retire",
        "rollback",
        "feedback"
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "operation_id",
    "arguments"
  ],
  "additionalProperties": false
}
