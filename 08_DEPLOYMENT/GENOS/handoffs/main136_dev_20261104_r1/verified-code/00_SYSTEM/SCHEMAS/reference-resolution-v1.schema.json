{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:8-agent:reference-resolution-v1",
  "$defs": {
    "ModelCaseResult": {
      "type": "object",
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "selected_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "maxItems": 64,
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "maxItems": 32,
          "uniqueItems": true
        },
        "abstain_reason": {"type": ["string", "null"]},
        "explanation": {"type": "string"}
      },
      "required": ["case_id", "selected_candidate_ids", "evidence_ids", "abstain_reason", "explanation"],
      "additionalProperties": false
    },
    "ReferenceResolutionOutput": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/ModelCaseResult"},
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": ["cases"],
      "additionalProperties": false
    },
    "ReviewDecision": {
      "type": "object",
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "enum": ["APPROVE", "REJECT", "UNKNOWN"]},
        "reviewer": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["case_id", "decision", "reviewer", "reason"],
      "additionalProperties": false
    },
    "ApplyReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "reference-resolution-apply-v1"},
        "parent_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "review_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_cases": {"type": "integer", "minimum": 0},
        "reviewed_cases": {"type": "integer", "minimum": 0}
      },
      "required": ["schema_version", "parent_index_sha256", "review_state_sha256", "approved_set_sha256", "output_index_sha256", "approved_cases", "reviewed_cases"],
      "additionalProperties": false
    }
  }
}
