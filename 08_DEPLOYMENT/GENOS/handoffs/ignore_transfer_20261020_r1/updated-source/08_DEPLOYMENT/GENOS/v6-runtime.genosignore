# GENOS full code ZIP exclusions. Gitignore syntax; independent of .gitignore.
# Read by: python 06_TOOLS/COMMANDS/code_ship.py pack --ignore-file genosIgnore
# Data (including raw glossary/document inputs) travels separately.
.git/
.venv/
venv/
env/
node_modules/
*.js
*.jsx
*.mjs
*.cjs
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.tox/
.nox/
*.egg-info/
.coverage*
htmlcov/
.idea/
.vscode/
/.agents/
/.codex/
/.claude/
/.github/
/.githooks/
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
*.log
*.bak
*.orig
*.tmp
*.zip
*.zip.part*
*.tar
*.gz
*.7z
*.b64.txt
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
/CODE_MANIFEST.json
/90_RUNTIME/
/09_ARTIFACTS/
/99_ARCHIVE/
/TRANSFER/
