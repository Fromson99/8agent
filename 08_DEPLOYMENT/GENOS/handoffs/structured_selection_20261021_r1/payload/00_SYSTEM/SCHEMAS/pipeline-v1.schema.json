          "minLength": 1
        },
        "language_state": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "read_contract": {
          "type": "object",
          "properties": {
            "view_rows": {
              "type": "integer",
              "minimum": 0
