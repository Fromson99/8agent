            "string_chars": {
              "type": "integer",
              "minimum": 0
            },
            "preview_chars": {
              "type": "integer",
              "minimum": 0
            },
            "notes_chars": {
              "type": "integer",
              "minimum": 0
            },
            "max_model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "incomplete": {
              "type": "string",
              "minLength": 1
