+def _log_received_mode(data):
+    """Log only recognized selector values; never dump the chat payload."""
+    fields = data.get("applied_fields")
+    value = fields.get("mode") if isinstance(fields, dict) else None
+    selected = _MODE_LABELS.get(value.strip()) if isinstance(value, str) else None
+    if fields is None:
+        state = "NO_APPLIED_FIELDS"
+    elif not isinstance(fields, dict):
+        state = "INVALID_APPLIED_FIELDS"
+    elif "mode" not in fields:
+        state = "MISSING_MODE"
+    elif value is None or isinstance(value, str) and not value.strip():
+        state = "EMPTY_MODE"
+    elif not isinstance(value, str):
+        state = "INVALID_MODE_TYPE"
+    else:
+        state = "SELECTED" if selected else "UNRECOGNIZED_MODE"
+    _log_event("workflow.mode.received", request_id=data.get("request_id"),
+        mode_log_revision=MODE_LOG_REVISION, mode_status=state,
+        received_mode=value.strip() if selected else None, selected_mode=selected,
+        mode_present=isinstance(fields, dict) and "mode" in fields,
+        doctype_present=isinstance(fields, dict) and "doctype" in fields)
+
+
+def _log_forwarded_mode(body, transport):
+    """Report the actual legal request prefix immediately before HTTP send."""
+    if body.get("API_TYPE") != "LEGAL_AGENT":
+        return
+    question = body.get("question")
+    match = _MODE_PREFIX.match(question) if isinstance(question, str) else None
+    mode = _MODE_LABELS[match.group(1)] if match else None
+    _log_event("workflow.mode.forwarding", request_id=body.get("request_id"),
+        mode_log_revision=MODE_LOG_REVISION, outgoing_mode=mode,
+        source_category={"내규":"internal", "외규":"external", "전체 법령":"ALL"}.get(mode),
+        routing="compare" if mode == "대사" else "rag", transport=transport)
 
 
