{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-shortcut-v1",
  "type": "object",
  "required": [
    "schema_version", "shortcut_id", "status", "signature_sha256",
    "source_set_sha256", "authority_generation", "semantic_generation",
    "landings", "feedback_event_ids", "evidence_receipt_sha256",
    "revision", "previous_record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "query-shortcut-v1"},
    "shortcut_id": {"type": "string"},
    "status": {"enum": ["CANDIDATE", "REVIEWED", "PINNED", "STALE", "REJECTED"]},
    "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_generation": {"type": "string", "minLength": 1},
    "semantic_generation": {"type": "string", "minLength": 1},
    "landings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": {"enum": ["STRUCTURAL_UNIT", "SEMANTIC_CLAUSE", "RULE", "PROVISO", "RELATION"]},
          "id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "feedback_event_ids": {
      "type": "array", "items": {"type": "string"}, "uniqueItems": true
    },
    "evidence_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_record_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
