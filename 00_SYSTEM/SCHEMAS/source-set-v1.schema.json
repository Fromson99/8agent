{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-set-v1",
  "type": "object",
  "required": ["schema_version", "source_set_id", "generation_id", "conflict_policy", "members"],
  "properties": {
    "schema_version": {"const": "source-set-v1"},
    "source_set_id": {"type": "string"},
    "generation_id": {"type": "string"},
    "conflict_policy": {"enum": ["error", "keep_namespaced", "explicit_priority"]},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["package_id", "priority"],
        "properties": {
          "package_id": {"type": "string"},
          "priority": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "cross_dataset_relations": {"type": "boolean"}
  },
  "additionalProperties": false
}
