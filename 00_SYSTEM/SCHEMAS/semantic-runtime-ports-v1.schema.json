      "type": "object",
      "required": [
        "schema_version",
        "generation_id",
        "store_sha256",
        "data_status"
      ],
      "properties": {
        "schema_version": {
          "const": "semantic-runtime-generation-v1"
        },
        "generation_id": {
          "type": "string"
        },
        "store_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data_status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "EXAMPLE"
