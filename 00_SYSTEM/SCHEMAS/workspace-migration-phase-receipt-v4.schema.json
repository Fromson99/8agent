{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-migration-phase-receipt-v4",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "workspace_manifest_sha256",
    "plan_sha256",
    "sequence",
    "completed_phases",
    "prior_receipt_sha256s",
    "items",
    "canonical_root_bindings",
    "source_deleted",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "workspace-migration-phase-receipt-v4"},
    "phase": {
      "enum": ["copy-verify-0", "dual-read-compare", "final-verify"]
    },
    "workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "sequence": {
      "const": ["copy-verify-0", "dual-read-compare", "final-verify"]
    },
    "completed_phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": ["copy-verify-0", "dual-read-compare", "final-verify"]
      },
      "uniqueItems": true
    },
    "prior_receipt_sha256s": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/sha256"},
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase_item"}
    },
    "canonical_root_bindings": {
      "type": "array",
      "items": {
        "$ref": "workspace-canonical-root-readiness-v3.schema.json"
      },
      "uniqueItems": true
    },
    "source_deleted": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"phase": {"const": "copy-verify-0"}}
      },
      "then": {
        "properties": {
          "completed_phases": {"const": ["copy-verify-0"]},
          "prior_receipt_sha256s": {"maxItems": 0},
          "canonical_root_bindings": {"maxItems": 0},
          "items": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "published",
                    "already-present",
                    "already-present-race"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"const": "dual-read-compare"}}
      },
      "then": {
        "properties": {
          "completed_phases": {
            "const": ["copy-verify-0", "dual-read-compare"]
          },
          "prior_receipt_sha256s": {"minItems": 1, "maxItems": 1},
          "canonical_root_bindings": {"maxItems": 0},
          "items": {
            "items": {
              "properties": {"status": {"const": "matched"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"const": "final-verify"}}
      },
      "then": {
        "properties": {
          "completed_phases": {
            "const": [
              "copy-verify-0",
              "dual-read-compare",
              "final-verify"
            ]
          },
          "prior_receipt_sha256s": {"minItems": 2, "maxItems": 2},
          "canonical_root_bindings": {"minItems": 1},
          "items": {
            "items": {
              "properties": {"status": {"const": "verified"}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\\\\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000\\uFEFF])(?!(?:.*/)?\\.{1,2}(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "fingerprint": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "bytes",
        "content_sha256",
        "merkle_sha256",
        "file_count",
        "directory_count"
      ],
      "properties": {
        "kind": {"enum": ["file", "directory"]},
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}(?![\\s\\S])"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "merkle_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 0},
        "directory_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "file"}}},
          "then": {
            "properties": {
              "file_count": {"const": 1},
              "directory_count": {"const": 0}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "directory"}}},
          "then": {
            "properties": {"directory_count": {"minimum": 1}}
          }
        }
      ]
    },
    "phase_item": {
      "type": "object",
      "required": [
        "source",
        "target",
        "status",
        "publish_strategy",
        "fingerprint"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/relative_path"},
        "target": {"$ref": "#/$defs/relative_path"},
        "status": {
          "enum": [
            "published",
            "already-present",
            "already-present-race",
            "matched",
            "verified"
          ]
        },
        "publish_strategy": {
          "enum": [
            "renameat2",
            "hardlink",
            "reserved-directory",
            "already-present"
          ]
        },
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      },
      "additionalProperties": false
    }
  }
}
